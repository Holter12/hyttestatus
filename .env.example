# Application
APP_ENV=development
APP_NAME=Hyttestatus
APP_SECRET_KEY=replace-with-a-long-random-secret
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=Europe/Oslo

# Database
POSTGRES_DB=hyttestatus
POSTGRES_USER=hyttestatus
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://hyttestatus:replace-with-a-strong-password@db:5432/hyttestatus

# Initial location
DEFAULT_LOCATION_NAME=Hytte
DEFAULT_LOCATION_SLUG=hytte

# Victron VRM - configure after confirming current VRM API credentials/API details
VRM_API_TOKEN=
VRM_INSTALLATION_ID=

# Optional bootstrap administrator; do not use real credentials in Git
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace-me
